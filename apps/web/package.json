{
  "name": "@nabu/web",
  "version": "0.0.0",
  "private": true,
  "description": "Nabu web client (React + Vite): course list, the course path, and planned sessions over compiled bundles, with an on-device event log.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "codegen": "node ../../packages/ui/scripts/css-module-types.ts --root src",
    "typecheck": "node ../../packages/ui/scripts/css-module-types.ts --root src --check && tsc -p tsconfig.json && tsc -p sw/tsconfig.json",
    "lint": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/push-notifications": "8.1.3",
    "@nabu/core": "workspace:*",
    "@nabu/i18n": "workspace:*",
    "@nabu/schema": "workspace:*",
    "@nabu/ui": "workspace:*",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
