{
  "name": "@nabu/api",
  "version": "0.0.0",
  "private": true,
  "description": "Nabu API server (Hono on Node): accounts, the learner event log and sync, game and AI services, over Postgres or PGlite.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/main.ts --dev",
    "start": "node src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "evals": "node scripts/evals.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.14",
    "@hono/node-server": "^2.1.6",
    "@nabu/core": "workspace:*",
    "@nabu/i18n": "workspace:*",
    "@nabu/schema": "workspace:*",
    "ajv": "^8.20.0",
    "drizzle-orm": "0.45.4",
    "hono": "^4.13.16",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
